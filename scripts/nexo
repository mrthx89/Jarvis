#!/usr/bin/env bash
# Nexo CLI Dispatcher
set -e

TARGET="${BASH_SOURCE[0]}"
while [ -h "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$REPO_ROOT/server"

PYTHON_BIN="$SERVER_DIR/.venv/bin/python"
if [ ! -f "$PYTHON_BIN" ]; then
    if [ -f "/data/home/Nexo/server/.venv/bin/python" ]; then
        PYTHON_BIN="/data/home/Nexo/server/.venv/bin/python"
    else
        PYTHON_BIN="python3"
    fi
fi

if [ -d "$SERVER_DIR/src" ]; then
    export PYTHONPATH="$SERVER_DIR/src:${PYTHONPATH}"
else
    export PYTHONPATH="/data/home/Nexo/server/src:${PYTHONPATH}"
fi

if [ "$1" = "session" ]; then
    shift
    exec "$PYTHON_BIN" "$SCRIPT_DIR/nexo_session.py" "$@"
else
    case "$1" in
        send|watch|stream|listen|transcript|history|link|speak|bridge|status|iot)
            exec "$PYTHON_BIN" "$SCRIPT_DIR/nexo_session.py" "$@"
            ;;
        *)
            exec "$PYTHON_BIN" "$SCRIPT_DIR/nexo_session.py" "$@"
            ;;
    esac
fi
