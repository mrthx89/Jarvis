<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_bottom_sheet_modal"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/voiceprint_sheet_title"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/setup_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voiceprint_sheet_desc"
            android:textSize="16sp"
            android:textColor="@color/setup_secondary" />
        <LinearLayout
            android:id="@+id/cardVoiceprintStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivSheetStatusLed"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/led_dot"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/tvVoiceprintCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voiceprint_loading"
                    android:textColor="@color/setup_text"
                    android:textSize="16sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvVoiceprintDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/setup_secondary"
                android:textSize="16sp" />
            <LinearLayout
                android:id="@+id/layoutVoiceprintMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvVoiceprintMetaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/setup_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardEnrollHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/voiceprintFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/voiceprint_loading"
                android:textColor="@color/setup_text"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/tvEnrollHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/voiceprint_before_recording"
                android:textColor="@color/setup_text"
                android:textSize="18sp" />
            <ProgressBar
                android:id="@+id/voiceprintProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:visibility="gone"
                android:contentDescription="@string/voiceprint_recording_progress" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/voiceprint_input_label"
                android:textColor="@color/setup_secondary"
                android:textSize="14sp" />
            <ProgressBar
                android:id="@+id/voiceprintInputLevel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:contentDescription="@string/voiceprint_input_label" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceprintEnroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:singleLine="false"
            android:layout_marginTop="24dp"
            android:text="@string/voiceprint_btn_enroll"
            android:textAllCaps="false"
            android:textColor="#0B1017"
            app:backgroundTint="@color/setup_accent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecordingFinish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:singleLine="false"
            android:text="@string/recording_finish"
            android:textAllCaps="false"
            android:textColor="#0B1017"
            android:visibility="gone"
            app:backgroundTint="@color/setup_accent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecordingSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:singleLine="false"
            android:text="@string/recording_save"
            android:textAllCaps="false"
            android:textColor="#0B1017"
            android:visibility="gone"
            app:backgroundTint="@color/setup_accent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecordingResume"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:singleLine="false"
            android:text="@string/recording_resume"
            android:textAllCaps="false"
            android:textColor="@color/setup_text"
            app:strokeColor="@color/setup_secondary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnosticOpen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:singleLine="false"
            android:text="@string/diagnostic_title"
            android:textAllCaps="false"
            android:textColor="@color/setup_text"
            app:strokeColor="@color/setup_secondary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnosticPlay"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:singleLine="false"
            android:text="@string/diagnostic_play"
            android:textAllCaps="false"
            android:textColor="@color/setup_text"
            android:visibility="gone"
            app:strokeColor="@color/setup_secondary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnosticDelete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:singleLine="false"
            android:text="@string/diagnostic_delete"
            android:textAllCaps="false"
            android:textColor="@color/setup_text"
            android:visibility="gone"
            app:strokeColor="@color/setup_secondary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceprintCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:singleLine="false"
            android:text="@string/voiceprint_cancel_recording"
            android:textAllCaps="false"
            android:visibility="gone"
            android:textColor="@color/setup_text" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceprintUnenroll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:singleLine="false"
            android:layout_marginTop="12dp"
            android:text="@string/voiceprint_btn_unenroll"
            android:textAllCaps="false"
            android:textColor="@color/setup_danger"
            app:strokeColor="@color/setup_danger"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceprintClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:singleLine="false"
            android:layout_marginTop="12dp"
            android:text="@string/voiceprint_btn_close"
            android:textAllCaps="false"
            android:textColor="@color/setup_text" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
