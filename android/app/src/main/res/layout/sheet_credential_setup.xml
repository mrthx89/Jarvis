<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_eyebrow"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textColor="@color/setup_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_title"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/setup_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_description"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/setup_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_setup_identity">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_device_label"
                android:textSize="12sp"
                android:textColor="@color/setup_secondary" />

            <TextView
                android:id="@+id/setupDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/setup_text"
                android:textIsSelectable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setupCopyId"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/setup_copy_id"
                android:textAllCaps="false"
                android:textColor="@color/setup_accent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@color/setup_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_server_label"
                android:textSize="12sp"
                android:textColor="@color/setup_secondary" />

            <TextView
                android:id="@+id/setupOrigin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/setup_text" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/setupTokenLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/setup_token_label"
            app:boxBackgroundColor="@color/setup_surface"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/setup_accent"
            app:hintTextColor="@color/setup_secondary"
            app:helperText="@string/setup_token_helper"
            app:helperTextTextColor="@color/setup_secondary"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/setupToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="textPassword|textNoSuggestions"
                android:singleLine="true"
                android:maxLength="128"
                android:saveEnabled="false"
                android:importantForAutofill="noExcludeDescendants"
                android:imeOptions="actionDone|flagNoPersonalizedLearning"
                android:textColor="@color/setup_text"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setupHelp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_help_title"
            android:textAllCaps="false"
            android:textColor="@color/setup_accent" />

        <TextView
            android:id="@+id/setupHelpBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:visibility="gone"
            android:text="@string/setup_help_body"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/setup_secondary"
            android:accessibilityLiveRegion="polite" />

        <CheckBox
            android:id="@+id/setupTrustOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_trust_origin"
            android:textColor="@color/setup_secondary"
            android:textSize="13sp"
            android:buttonTint="@color/setup_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setupSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/setup_save"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/bg_black"
            app:backgroundTint="@color/setup_accent"
            app:cornerRadius="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/setupCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/setup_cancel"
                android:textAllCaps="false"
                android:textColor="@color/setup_secondary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/setupReset"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/setup_reset"
                android:textAllCaps="false"
                android:textColor="@color/setup_danger" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
