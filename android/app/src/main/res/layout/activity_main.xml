<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainRoot"
    android:background="@color/bg_black"
    android:keepScreenOn="true">

    <!-- Top 3D Glassmorphic Status Pill -->
    <LinearLayout
        android:id="@+id/pillStatus"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        app:layout_constrainedWidth="true"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivStatusLed"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/led_dot"
            android:contentDescription="Status LED" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/status_connecting"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Voiceprint Biometric Status Pill -->
    <LinearLayout
        android:id="@+id/pillVoiceprint"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        app:layout_constrainedWidth="true"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pillStatus">

        <ImageView
            android:id="@+id/ivVoiceprintLed"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/led_dot"
            android:contentDescription="Voiceprint Status LED" />

        <TextView
            android:id="@+id/tvVoiceprintStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/voiceprint_hud_unregistered"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <Button
        android:id="@+id/toggleVoice"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:enabled="false"
        android:singleLine="false"
        android:ellipsize="none"
        android:text="@string/voice_start"
        android:textAllCaps="false"
        android:textColor="@color/nexo_cyan"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toBottomOf="@id/pillVoiceprint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/voiceMood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="@string/voice_mood_off"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:accessibilityLiveRegion="polite"
        app:layout_constraintTop_toBottomOf="@id/toggleVoice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Central Living 3D Mascot with Organic Physics & Transitions -->
    <id.my.yhdev.nexo.ui.VisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/consoleCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/voiceMood" />

    <!-- Bottom 3D Cyberdeck Curved Glass Console Readout -->
    <LinearLayout
        android:id="@+id/consoleCard"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_console_glass"
        android:orientation="vertical"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/consoleHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConsoleHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="NEXO // COGNITIVE STREAM"
                android:textColor="@color/nexo_cyan"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:alpha="0.8" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/copyReply"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:enabled="false"
                android:alpha="0.35"
                android:src="@drawable/ic_clipboard_24"
                android:contentDescription="@string/copy_reply"
                android:tooltipText="@string/copy_reply"
                app:tint="@color/nexo_cyan" />
        </LinearLayout>

        <!-- Subtitle & Live Transcription Readout -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:maxLines="6"
            android:scrollbars="vertical"
            android:lineSpacingExtra="4dp"
            android:text="@string/status_connecting"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
