    <string name="setup_token_helper">Masukkan token yang diterbitkan server untuk ID ini.</string>
    <string name="setup_help_title">Dari mana saya mendapat token?</string>
    <string name="setup_help_body">1. Salin ID perangkat ini dan kirim kepada pengelola server.\n2. Pengelola menerbitkan token khusus untuk ID dan server di atas melalui provisioning CLI.\n3. Ambil token dari file penyerahan privat, lalu masukkan di sini.\n\nToken bukan API key Firebase dan tidak tersedia di Remote Config. Jangan kirim token ke chat atau log. Panduan pengelola: docs/DEVICE_AUTH.md.</string>
    <string name="setup_trust_origin">Saya sudah memastikan alamat server ini milik saya.</string>
    <string name="setup_save">Simpan dan hubungkan</string>
    <string name="setup_cancel">Nanti saja</string>
    <string name="setup_reset">Hapus token lokal</string>
    <string name="setup_invalid_token">Token harus berisi 43–128 karakter huruf, angka, _ atau -.</string>
    <string name="setup_save_failed">Token gagal disimpan. Periksa Android Keystore lalu coba lagi.</string>
    <string name="setup_stale_origin">Server telah berubah. Tutup formulir dan verifikasi server terbaru.</string>
    <string name="setup_reset_title">Hapus akses dari perangkat ini?</string>
    <string name="setup_reset_body">Jarvis akan berhenti terhubung sampai Anda memasukkan token lagi. Ini hanya menghapus token lokal, bukan mencabut token di server.</string>
    <string name="setup_reset_confirm">Hapus token</string>
    <string name="setup_back">Kembali</string>
    <string name="setup_reset_failed">Token lokal gagal dihapus. Coba lagi.</string>
    <string name="setup_id_copied">ID perangkat disalin. Token tidak disalin.</string>
    <string name="setup_saved">Token tersimpan. Menghubungkan ke server…</string>
    <style name="ThemeOverlay.Jarvis.CredentialSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Jarvis.CredentialSheet</item>
        <item name="colorSurface">@color/setup_panel</item>
        <item name="colorPrimary">@color/setup_accent</item>
        <item name="colorOnSurface">@color/setup_text</item>
        <item name="android:colorBackground">@color/setup_panel</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_secondary</item>
        <item name="android:navigationBarColor">@color/setup_panel</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Widget.Jarvis.CredentialSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/setup_panel</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Jarvis.CredentialSheet</item>
    </style>
    <style name="ShapeAppearanceOverlay.Jarvis.CredentialSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
