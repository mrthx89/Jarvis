<?xml version="1.0" encoding="utf-8"?>
<!-- Functional control boundaries and keyboard/D-pad focus, not decoration. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#141B26" />
            <stroke android:width="3dp" android:color="#00E5FF" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#2A394E" />
            <stroke android:width="3dp" android:color="#00E5FF" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#141B26" />
            <stroke android:width="2dp" android:color="#748297" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
